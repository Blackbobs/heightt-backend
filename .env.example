# .env.example
# Copy this file to .env and fill in your values

# ============================================
# Server Configuration
# ============================================
NODE_ENV=development
PORT=3000

# ============================================
# Database
# ============================================
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your-secure-password
DB_NAME=heightt_db

# ============================================
# Redis
# ============================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password
# OR if using Upstash REST API:
UPSTASH_REDIS_REST_URL=https://glorious-ghost-126142.upstash.io
UPSTASH_REDIS_REST_TOKEN=gQAAAAAAAey-AAIgcDFlYjU0MmMxMTk3ZDY0MmFkYjkxMmZhNTQ5Nzc0OGZiZg

# ============================================
# JWT
# ============================================
JWT_ACCESS_SECRET=your-super-secret-access-key
JWT_REFRESH_SECRET=your-super-secret-refresh-key
JWT_ACCESS_EXPIRY=900
JWT_REFRESH_EXPIRY=604800

# ============================================
# Paystack
# ============================================
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxxxxxxxxxx

# ============================================
# Frontend
# ============================================
FRONTEND_URL=https://yourdomain.com
CORS_ORIGIN=https://yourdomain.com,https://admin.yourdomain.com
# Comma-separated exact origins allowed for Bachs success/cancel redirects.
PAYMENT_REDIRECT_ORIGINS=https://yourdomain.com,https://admin.yourdomain.com

# Bachs payments. BACHS_WEBHOOK_SECRET is the endpoint signing secret from
# the Bachs webhook dashboard, not the general API key.
BACHS_API_KEY=sk_live_xxxxxxxxxxxxxxxxx
BACHS_BASE_URL=https://api.bachs.io
BACHS_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxx
BACHS_WEBHOOK_TOLERANCE=300

# CSRF is always enabled. Browser clients must first GET
# /api/v1/auth/csrf-token with credentials enabled, then send the returned
# token as X-CSRF-Token on POST, PUT, PATCH, and DELETE requests.


# ============================================
# Rate Limiting
# ============================================
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ============================================
# Logging
# ============================================
LOG_LEVEL=info

# ============================================
# File Upload
# ============================================
MAX_FILE_SIZE=5242880
UPLOAD_DIR=./uploads

# ============================================
# Cloudinary
# ============================================
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
