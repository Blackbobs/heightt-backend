generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// DOMAIN 1: AUTHENTICATION
// ============================================

model User {
  id           String @id @default(cuid())
  email        String @unique
  username     String @unique
  passwordHash String

  emailVerified Boolean    @default(false)
  status        UserStatus @default(ACTIVE)

  lastLoginAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  deletedBy String?

  // Relations
  profile                 UserProfile?
  sessions                Session[]
  passwordResets          PasswordReset[]
  emailVerifications      EmailVerification[]
  studentProfile          StudentProfile?
  auditLogs               AuditLog[]
  operationalAuditLogs    OperationalAuditLog[]
  activityLogs            ActivityLog[]
  createdOrganizations    Organization[]           @relation("OrganizationCreator")
  notifications           Notification[]
  announcementReads       AnnouncementRead[]
  eventRegistrations      EventRegistration[]
  votes                   Vote[]
  candidates              Candidate[]
  ticketPurchases         TicketPurchase[]
  payments                Payment[]
  withdrawals             Withdrawal[]
  savingsGoals            SavingsGoal[]
  wallet                  Wallet?
  featureFlagTargets      FeatureFlagTarget[]
  executiveMembers        ExecutiveMember[]
  announcementAuthor      Announcement[]           @relation("AnnouncementAuthor")
  notificationPreferences NotificationPreference[]
  pushQueues              PushQueue[]
  organizationMemberships OrganizationMembership[]

  @@index([email])
  @@index([username])
  @@index([status])
  @@map("users")
}

model Session {
  id     String @id @default(cuid())
  userId String

  refreshTokenHash String @unique

  deviceName      String?
  browser         String?
  operatingSystem String?
  ipAddress       String?
  userAgent       String?

  revokedReason String?

  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  lastUsedAt DateTime  @default(now())
  revokedAt  DateTime?
  isActive   Boolean   @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshTokenHash])
  @@index([isActive])
  @@map("sessions")
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("password_resets")
}

model EmailVerification {
  id         String    @id @default(cuid())
  userId     String
  email      String
  token      String    @unique
  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("email_verifications")
}

// ============================================
// DOMAIN 2: USER PROFILE
// ============================================

model UserProfile {
  id     String @id @default(cuid())
  userId String @unique

  firstName  String
  lastName   String
  middleName String?
  phone      String?
  avatar     String?

  gender      Gender?
  dateOfBirth DateTime?
  country     String?
  state       String?
  city        String?
  address     String?

  bio String?

  onboardingStep        OnboardingStep @default(PERSONAL_INFO)
  onboardingCompleted   Boolean        @default(false)
  onboardingCompletedAt DateTime?

  verificationStatus VerificationStatus @default(UNVERIFIED)
  verifiedAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

// ============================================
// DOMAIN 3: INSTITUTION MANAGEMENT
// ============================================

model Institution {
  id        String  @id @default(cuid())
  name      String
  shortName String
  code      String  @unique
  logo      String?
  website   String?
  email     String?
  phone     String?
  address   String?
  city      String?
  state     String?
  country   String?

  status InstitutionStatus @default(ACTIVE)

  createdBy String?
  updatedBy String?

  deletedAt DateTime?
  deletedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  faculties     Faculty[]
  sessions      AcademicSession[]
  organizations Organization[]
  students      StudentProfile[]
  dues          Due[]

  @@index([code])
  @@map("institutions")
}

model Faculty {
  id            String        @id @default(cuid())
  institutionId String
  name          String
  code          String
  status        FacultyStatus @default(ACTIVE)

  createdBy String?
  updatedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  institution   Institution      @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  departments   Department[]
  organizations Organization[]
  students      StudentProfile[]

  @@unique([institutionId, code])
  @@index([institutionId])
  @@map("faculties")
}

model Department {
  id        String @id @default(cuid())
  facultyId String
  name      String
  code      String

  promotionType PromotionType
  status        DepartmentStatus @default(ACTIVE)

  createdBy String?
  updatedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  faculty         Faculty                 @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  academicLevels  AcademicLevel[]
  organizations   Organization[]
  studentProfiles StudentProfile[]
  students        StudentAcademicRecord[]

  @@unique([facultyId, code])
  @@index([facultyId])
  @@map("departments")
}

model AcademicLevel {
  id           String @id @default(cuid())
  departmentId String

  name         String
  numericLevel Int
  order        Int

  status AcademicLevelStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  students        StudentProfile[]
  academicRecords StudentAcademicRecord[]
  organizations   Organization[]
  promotionsFrom  StudentPromotion[]      @relation("FromLevel")
  promotionsTo    StudentPromotion[]      @relation("ToLevel")

  @@unique([departmentId, name])
  @@index([departmentId])
  @@map("academic_levels")
}

model AcademicSession {
  id            String                @id @default(cuid())
  institutionId String
  name          String
  startDate     DateTime
  endDate       DateTime
  status        AcademicSessionStatus
  isCurrent     Boolean               @default(false)

  createdBy String?
  updatedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  institution    Institution              @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  dues           Due[]
  studentRecords StudentAcademicRecord[]
  memberships    OrganizationMembership[]
  promotions     StudentPromotion[]

  @@unique([institutionId, name])
  @@index([institutionId])
  @@index([isCurrent])
  @@map("academic_sessions")
}

// ============================================
// DOMAIN 4: STUDENT DOMAIN
// ============================================

model StudentProfile {
  id     String @id @default(cuid())
  userId String @unique

  institutionId          String
  facultyId              String
  departmentId           String
  currentAcademicLevelId String?
  matricNumber           String?

  academicStatus AcademicStatus @default(ACTIVE)

  onboardingStep        OnboardingStep @default(INSTITUTION)
  onboardingCompleted   Boolean        @default(false)
  onboardingCompletedAt DateTime?

  verificationStatus VerificationStatus @default(UNVERIFIED)
  verifiedAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                 User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution          Institution    @relation(fields: [institutionId], references: [id])
  faculty              Faculty        @relation(fields: [facultyId], references: [id])
  department           Department     @relation(fields: [departmentId], references: [id])
  currentAcademicLevel AcademicLevel? @relation(fields: [currentAcademicLevelId], references: [id])

  academicRecords StudentAcademicRecord[]
  promotions      StudentPromotion[]
  enrollments     StudentEnrollment[]
  verifications   StudentVerification[]
  dueAssignments  DueAssignment[]

  @@index([userId])
  @@index([institutionId])
  @@index([facultyId])
  @@index([departmentId])
  @@index([matricNumber])
  @@map("student_profiles")
}

model StudentAcademicRecord {
  id              String @id @default(cuid())
  studentId       String
  sessionId       String
  departmentId    String
  academicLevelId String

  gpa              Float?
  cgpa             Float?
  creditsAttempted Int?
  creditsEarned    Int?

  status AcademicStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student       StudentProfile  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  session       AcademicSession @relation(fields: [sessionId], references: [id])
  department    Department      @relation(fields: [departmentId], references: [id])
  academicLevel AcademicLevel   @relation(fields: [academicLevelId], references: [id])

  @@unique([studentId, sessionId])
  @@index([studentId])
  @@index([sessionId])
  @@map("student_academic_records")
}

model StudentPromotion {
  id            String   @id @default(cuid())
  studentId     String
  fromLevelId   String
  toLevelId     String
  sessionId     String
  promotedBy    String?
  promotionDate DateTime @default(now())
  notes         String?

  student   StudentProfile  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fromLevel AcademicLevel   @relation("FromLevel", fields: [fromLevelId], references: [id])
  toLevel   AcademicLevel   @relation("ToLevel", fields: [toLevelId], references: [id])
  session   AcademicSession @relation(fields: [sessionId], references: [id])

  @@map("student_promotions")
}

model StudentEnrollment {
  id             String  @id @default(cuid())
  studentId      String
  organizationId String
  roleId         String?

  status      EnrollmentStatus @default(ACTIVE)
  enrolledAt  DateTime         @default(now())
  completedAt DateTime?

  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  organization Organization   @relation(fields: [organizationId], references: [id])
  role         Role?          @relation(fields: [roleId], references: [id])

  @@unique([studentId, organizationId])
  @@index([studentId])
  @@index([organizationId])
  @@map("student_enrollments")
}

model StudentVerification {
  id          String             @id @default(cuid())
  studentId   String
  verifiedBy  String?
  status      VerificationStatus @default(PENDING)
  documentUrl String?
  notes       String?

  requestedAt DateTime  @default(now())
  verifiedAt  DateTime?
  expiresAt   DateTime?

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([status])
  @@map("student_verifications")
}

// ============================================
// DOMAIN 5: ORGANIZATIONS
// ============================================

model Organization {
  id String @id @default(cuid())

  institutionId        String
  facultyId            String?
  departmentId         String?
  academicLevelId      String?
  parentOrganizationId String?

  name        String
  slug        String  @unique
  description String?

  type  OrganizationType
  scope OrganizationScope

  status OrganizationStatus @default(DRAFT)

  createdBy   String?
  updatedBy   String?
  activatedAt DateTime?
  archivedAt  DateTime?
  deletedAt   DateTime?
  deletedBy   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  institution   Institution    @relation(fields: [institutionId], references: [id])
  faculty       Faculty?       @relation(fields: [facultyId], references: [id])
  department    Department?    @relation(fields: [departmentId], references: [id])
  academicLevel AcademicLevel? @relation(fields: [academicLevelId], references: [id])
  parent        Organization?  @relation("OrganizationHierarchy", fields: [parentOrganizationId], references: [id])
  children      Organization[] @relation("OrganizationHierarchy")
  creator       User?          @relation("OrganizationCreator", fields: [createdBy], references: [id])

  memberships        OrganizationMembership[]
  roles              Role[]
  dues               Due[]
  announcements      Announcement[]
  events             Event[]
  wallet             Wallet?
  studentEnrollments StudentEnrollment[]
  featureFlagTargets FeatureFlagTarget[]
  elections          Election[]
  executiveTerms     ExecutiveTerm[]
  committees         Committee[]
  ledgerAccounts     LedgerAccount[]
  settlements        Settlement[]
  payments           Payment[]

  @@unique([institutionId, slug])
  @@index([institutionId])
  @@index([facultyId])
  @@index([departmentId])
  @@index([academicLevelId])
  @@index([type])
  @@index([status])
  @@map("organizations")
}

model OrganizationMembership {
  id             String @id @default(cuid())
  organizationId String
  userId         String

  membershipType MembershipType
  status         MembershipStatus
  isPrimary      Boolean          @default(false)

  joinedAt        DateTime
  joinedSessionId String?
  leftAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id])
  user         User             @relation(fields: [userId], references: [id])
  session      AcademicSession? @relation(fields: [joinedSessionId], references: [id])
  roles        MembershipRole[]

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId])
  @@index([status])
  @@map("organization_memberships")
}

// ============================================
// DOMAIN 6: RBAC
// ============================================

model Role {
  id             String @id @default(cuid())
  organizationId String

  name        String
  description String?
  isSystem    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization       Organization        @relation(fields: [organizationId], references: [id])
  permissions        RolePermission[]
  members            MembershipRole[]
  studentEnrollments StudentEnrollment[]
  featureFlagTargets FeatureFlagTarget[]
  executiveMembers   ExecutiveMember[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("roles")
}

model Permission {
  id          String  @id @default(cuid())
  key         String  @unique
  name        String
  description String?
  category    String?

  createdAt DateTime @default(now())

  roles RolePermission[]

  @@index([key])
  @@index([category])
  @@map("permissions")
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model MembershipRole {
  id           String   @id @default(cuid())
  membershipId String
  roleId       String
  assignedBy   String?
  assignedAt   DateTime @default(now())

  membership OrganizationMembership @relation(fields: [membershipId], references: [id])
  role       Role                   @relation(fields: [roleId], references: [id])

  @@unique([membershipId, roleId])
  @@map("membership_roles")
}

// ============================================
// DOMAIN 7: FINANCE & LEDGER
// ============================================

model Wallet {
  id             String  @id @default(cuid())
  userId         String?
  organizationId String?

  balance     Decimal      @default(0)
  heldBalance Decimal      @default(0)
  currency    String       @default("NGN")
  status      WalletStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User?         @relation(fields: [userId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])
  holds        WalletHold[]
  transactions Transaction[]
  withdrawals  Withdrawal[]

  @@unique([userId])
  @@unique([organizationId])
  @@map("wallets")
}

model WalletHold {
  id        String     @id @default(cuid())
  walletId  String
  amount    Decimal
  reason    String?
  expiresAt DateTime?
  status    HoldStatus @default(ACTIVE)

  createdAt  DateTime  @default(now())
  releasedAt DateTime?

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([status])
  @@map("wallet_holds")
}

model LedgerAccount {
  id             String            @id @default(cuid())
  organizationId String?
  name           String
  code           String            @unique
  type           LedgerAccountType
  balance        Decimal           @default(0)
  currency       String            @default("NGN")
  isActive       Boolean           @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id])
  entries      LedgerEntry[]

  @@index([organizationId])
  @@index([code])
  @@map("ledger_accounts")
}

model LedgerEntry {
  id            String @id @default(cuid())
  accountId     String
  transactionId String

  amount        Decimal
  type          LedgerEntryType
  balanceBefore Decimal
  balanceAfter  Decimal
  description   String?

  createdAt DateTime @default(now())

  account     LedgerAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  transaction Transaction   @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([transactionId])
  @@map("ledger_entries")
}

model Transaction {
  id       String @id @default(cuid())
  walletId String

  type      TransactionType
  amount    Decimal
  fee       Decimal         @default(0)
  netAmount Decimal

  status TransactionStatus @default(PENDING)

  reference   String  @unique
  description String?
  metadata    Json?

  completedAt   DateTime?
  failedAt      DateTime?
  failureReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  wallet     Wallet        @relation(fields: [walletId], references: [id], onDelete: Cascade)
  entries    LedgerEntry[]
  payment    Payment?
  settlement Settlement?
  withdrawal Withdrawal?
  refund     Refund?

  @@index([walletId])
  @@index([reference])
  @@index([status])
  @@map("transactions")
}

model Payment {
  id             String  @id @default(cuid())
  payerId        String
  organizationId String
  transactionId  String? @unique

  amount        Decimal
  serviceFee    Decimal           @default(0)
  status        PaymentStatus     @default(PENDING)
  paymentMethod PaymentMethodType

  reference   String  @unique
  description String?
  metadata    Json?

  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  payer        User         @relation(fields: [payerId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  transaction  Transaction? @relation(fields: [transactionId], references: [id])
  duePayment   DuePayment?
  refund       Refund?

  @@index([payerId])
  @@index([organizationId])
  @@index([reference])
  @@index([status])
  @@map("payments")
}

model Due {
  id             String    @id @default(cuid())
  organizationId String
  sessionId      String?
  institutionId  String?
  name           String
  description    String?
  amount         Decimal
  dueDate        DateTime
  lateFee        Decimal   @default(0)
  isRequired     Boolean   @default(true)
  status         DueStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  institution  Institution?     @relation(fields: [institutionId], references: [id])
  organization Organization     @relation(fields: [organizationId], references: [id])
  session      AcademicSession? @relation(fields: [sessionId], references: [id])
  assignments  DueAssignment[]

  @@index([organizationId])
  @@index([status])
  @@map("dues")
}

model DueAssignment {
  id        String    @id @default(cuid())
  dueId     String
  studentId String
  amount    Decimal
  isPaid    Boolean   @default(false)
  paidAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  due         Due            @relation(fields: [dueId], references: [id], onDelete: Cascade)
  student     StudentProfile @relation(fields: [studentId], references: [id])
  duePayments DuePayment[]

  @@unique([dueId, studentId])
  @@index([studentId])
  @@index([isPaid])
  @@map("due_assignments")
}

model DuePayment {
  id           String   @id @default(cuid())
  assignmentId String
  paymentId    String   @unique
  amount       Decimal
  paidAt       DateTime @default(now())

  assignment DueAssignment @relation(fields: [assignmentId], references: [id])
  payment    Payment       @relation(fields: [paymentId], references: [id])

  @@map("due_payments")
}

model Withdrawal {
  id            String           @id @default(cuid())
  userId        String
  walletId      String
  transactionId String?          @unique
  amount        Decimal
  status        WithdrawalStatus @default(PENDING)
  bankName      String?
  accountNumber String?
  accountName   String?
  reference     String           @unique
  metadata      Json?

  requestedAt   DateTime  @default(now())
  processedAt   DateTime?
  completedAt   DateTime?
  failedAt      DateTime?
  failureReason String?

  user        User         @relation(fields: [userId], references: [id])
  wallet      Wallet       @relation(fields: [walletId], references: [id])
  transaction Transaction? @relation(fields: [transactionId], references: [id])
  refund      Refund?

  @@index([userId])
  @@index([walletId])
  @@index([status])
  @@map("withdrawals")
}

model Refund {
  id            String       @id @default(cuid())
  paymentId     String       @unique
  withdrawalId  String?      @unique
  amount        Decimal
  reason        String?
  status        RefundStatus @default(PENDING)
  transactionId String?      @unique
  transaction   Transaction? @relation(fields: [transactionId], references: [id])

  createdAt   DateTime  @default(now())
  processedAt DateTime?

  payment    Payment     @relation(fields: [paymentId], references: [id])
  withdrawal Withdrawal? @relation(fields: [withdrawalId], references: [id])

  @@index([paymentId])
  @@index([status])
  @@map("refunds")
}

model Settlement {
  id             String           @id @default(cuid())
  organizationId String
  transactionId  String           @unique
  amount         Decimal
  reference      String           @unique
  status         SettlementStatus @default(PENDING)

  settledAt DateTime?
  createdAt DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  transaction  Transaction  @relation(fields: [transactionId], references: [id])

  @@map("settlements")
}

model SavingsGoal {
  id            String        @id @default(cuid())
  userId        String
  title         String
  description   String?
  targetAmount  Decimal
  currentAmount Decimal       @default(0)
  targetDate    DateTime?
  status        SavingsStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User                 @relation(fields: [userId], references: [id])
  transactions SavingsTransaction[]

  @@index([userId])
  @@index([status])
  @@map("savings_goals")
}

model SavingsTransaction {
  id          String                 @id @default(cuid())
  goalId      String
  amount      Decimal
  type        SavingsTransactionType
  description String?

  createdAt DateTime @default(now())

  goal SavingsGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
  @@map("savings_transactions")
}

// ============================================
// DOMAIN 8: COMMUNICATION
// ============================================

model Announcement {
  id             String               @id @default(cuid())
  organizationId String
  authorId       String?
  title          String
  content        String
  type           AnnouncementType     @default(GENERAL)
  priority       AnnouncementPriority @default(NORMAL)

  isPublished Boolean   @default(false)
  publishedAt DateTime?
  expiresAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id])
  author       User?              @relation("AnnouncementAuthor", fields: [authorId], references: [id])
  reads        AnnouncementRead[]

  @@index([organizationId])
  @@index([isPublished])
  @@index([type])
  @@map("announcements")
}

model AnnouncementRead {
  id             String   @id @default(cuid())
  announcementId String
  userId         String
  readAt         DateTime @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id])

  @@unique([announcementId, userId])
  @@map("announcement_reads")
}

model Notification {
  id       String               @id @default(cuid())
  userId   String
  title    String
  body     String
  type     NotificationType
  priority NotificationPriority @default(NORMAL)

  read        Boolean   @default(false)
  readAt      DateTime?
  deliveredAt DateTime?

  data     Json?
  metadata Json?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@index([type])
  @@map("notifications")
}

model NotificationPreference {
  id     String           @id @default(cuid())
  userId String
  type   NotificationType

  email Boolean @default(true)
  push  Boolean @default(true)
  inApp Boolean @default(true)

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@map("notification_preferences")
}

model EmailQueue {
  id      String  @id @default(cuid())
  to      String
  from    String?
  subject String
  html    String
  text    String?

  status        QueueStatus @default(PENDING)
  attempts      Int         @default(0)
  maxAttempts   Int         @default(3)
  lastAttemptAt DateTime?
  errorMessage  String?

  scheduledAt DateTime?
  sentAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([status])
  @@index([scheduledAt])
  @@map("email_queue")
}

model PushQueue {
  id     String @id @default(cuid())
  userId String
  title  String
  body   String
  data   Json?

  status        QueueStatus @default(PENDING)
  attempts      Int         @default(0)
  maxAttempts   Int         @default(3)
  lastAttemptAt DateTime?
  errorMessage  String?

  scheduledAt DateTime?
  sentAt      DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("push_queue")
}

// ============================================
// DOMAIN 9: PLATFORM OPERATIONS
// ============================================

model FeatureFlag {
  id          String  @id @default(cuid())
  key         String  @unique
  name        String
  description String?
  enabled     Boolean @default(false)
  percentage  Int     @default(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  targets FeatureFlagTarget[]

  @@index([key])
  @@map("feature_flags")
}

model FeatureFlagTarget {
  id         String                @id @default(cuid())
  featureId  String
  targetType FeatureFlagTargetType

  userId         String?
  organizationId String?
  roleId         String?

  enabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  feature      FeatureFlag   @relation(fields: [featureId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])
  role         Role?         @relation(fields: [roleId], references: [id])

  @@unique([featureId, targetType, userId])
  @@unique([featureId, targetType, organizationId])
  @@unique([featureId, targetType, roleId])
  @@map("feature_flag_targets")
}

model MaintenanceMode {
  id       String    @id @default(cuid())
  enabled  Boolean   @default(false)
  message  String?
  startsAt DateTime?
  endsAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("maintenance_modes")
}

model KillSwitch {
  id          String  @id @default(cuid())
  key         String  @unique
  name        String
  description String?
  enabled     Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("kill_switches")
}

model PlatformSetting {
  id          String  @id @default(cuid())
  key         String  @unique
  value       String
  description String?
  isPublic    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("platform_settings")
}

model ReleaseChannel {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  waves DeploymentWave[]

  @@map("release_channels")
}

model DeploymentWave {
  id          String  @id @default(cuid())
  channelId   String
  name        String
  description String?
  percentage  Int
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  channel ReleaseChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@map("deployment_waves")
}

model ScheduledJob {
  id          String    @id @default(cuid())
  name        String
  description String?
  schedule    String
  handler     String
  status      JobStatus @default(PENDING)
  lastRunAt   DateTime?
  nextRunAt   DateTime?
  lastError   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("scheduled_jobs")
}

model OperationalAuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String?
  entityId  String?
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@index([action])
  @@map("operational_audit_logs")
}

// ============================================
// DOMAIN 10: AUDIT & ACTIVITY
// ============================================

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String?
  entityId  String?
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@index([action])
  @@map("audit_logs")
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  activity  String
  details   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@index([activity])
  @@map("activity_logs")
}

// ============================================
// DOMAIN 11: GOVERNANCE
// ============================================

model Election {
  id             String @id @default(cuid())
  organizationId String

  title       String
  description String?

  startDate DateTime
  endDate   DateTime

  status ElectionStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id])
  candidates   Candidate[]
  votes        Vote[]
  positions    ElectionPosition[]

  @@index([organizationId])
  @@index([status])
  @@map("elections")
}

model ElectionPosition {
  id            String  @id @default(cuid())
  electionId    String
  title         String
  description   String?
  maxCandidates Int     @default(1)
  maxVotes      Int     @default(1)
  order         Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  election   Election    @relation(fields: [electionId], references: [id], onDelete: Cascade)
  candidates Candidate[]

  @@map("election_positions")
}

model Candidate {
  id         String @id @default(cuid())
  electionId String
  positionId String
  userId     String

  manifesto String?
  photo     String?
  status    CandidateStatus @default(NOMINATED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  election Election         @relation(fields: [electionId], references: [id], onDelete: Cascade)
  position ElectionPosition @relation(fields: [positionId], references: [id])
  user     User             @relation(fields: [userId], references: [id])
  votes    Vote[]

  @@unique([electionId, positionId, userId])
  @@map("candidates")
}

model Vote {
  id          String @id @default(cuid())
  electionId  String
  candidateId String
  voterId     String

  createdAt DateTime @default(now())

  election  Election  @relation(fields: [electionId], references: [id], onDelete: Cascade)
  candidate Candidate @relation(fields: [candidateId], references: [id])
  voter     User      @relation(fields: [voterId], references: [id])

  @@unique([electionId, voterId, candidateId])
  @@map("votes")
}

model ExecutiveTerm {
  id             String @id @default(cuid())
  organizationId String

  title       String
  description String?

  startDate DateTime
  endDate   DateTime

  status TermStatus @default(UPCOMING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id])
  members      ExecutiveMember[]

  @@index([organizationId])
  @@map("executive_terms")
}

model ExecutiveMember {
  id     String @id @default(cuid())
  termId String
  userId String
  roleId String

  assignedAt DateTime @default(now())

  term ExecutiveTerm @relation(fields: [termId], references: [id], onDelete: Cascade)
  user User          @relation(fields: [userId], references: [id])
  role Role          @relation(fields: [roleId], references: [id])

  @@unique([termId, userId])
  @@map("executive_members")
}

model Committee {
  id             String          @id @default(cuid())
  organizationId String
  name           String
  description    String?
  purpose        String?
  status         CommitteeStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@map("committees")
}

// ============================================
// DOMAIN 12: EVENTS
// ============================================

model Event {
  id             String @id @default(cuid())
  organizationId String

  title       String
  description String?
  location    String?

  startDate DateTime
  endDate   DateTime

  capacity Int?
  isFree   Boolean  @default(true)
  price    Decimal? @default(0)

  status EventStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization  Organization        @relation(fields: [organizationId], references: [id])
  registrations EventRegistration[]
  tickets       Ticket[]

  @@index([organizationId])
  @@index([status])
  @@map("events")
}

model Ticket {
  id      String     @id @default(cuid())
  eventId String
  code    String     @unique
  type    TicketType @default(REGULAR)
  price   Decimal
  isUsed  Boolean    @default(false)
  usedAt  DateTime?

  createdAt DateTime @default(now())

  event    Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  purchase TicketPurchase?

  @@index([eventId])
  @@index([code])
  @@map("tickets")
}

model TicketPurchase {
  id       String @id @default(cuid())
  ticketId String @unique
  userId   String

  amount Decimal
  status TicketStatus @default(PENDING)

  purchasedAt DateTime @default(now())

  ticket       Ticket             @relation(fields: [ticketId], references: [id])
  user         User               @relation(fields: [userId], references: [id])
  registration EventRegistration?

  @@index([userId])
  @@map("ticket_purchases")
}

model EventRegistration {
  id               String  @id @default(cuid())
  eventId          String
  userId           String
  ticketPurchaseId String? @unique

  status RegistrationStatus @default(PENDING)

  registeredAt DateTime  @default(now())
  attendedAt   DateTime?

  event          Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user           User            @relation(fields: [userId], references: [id])
  ticketPurchase TicketPurchase? @relation(fields: [ticketPurchaseId], references: [id])
  attendance     Attendance?

  @@unique([eventId, userId])
  @@map("event_registrations")
}

model Attendance {
  id             String    @id @default(cuid())
  registrationId String    @unique
  checkedInAt    DateTime  @default(now())
  checkedOutAt   DateTime?

  registration EventRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@map("attendances")
}

