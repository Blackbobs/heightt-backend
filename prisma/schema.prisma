generator client {
  provider     = "prisma-client"
  output       = "../src/v1/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String                    @id @default(cuid())
  email                   String                    @unique
  passwordHash            String
  emailVerified           Boolean                   @default(false)
  lastLoginAt             DateTime?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  username                String                    @unique
  deletedAt               DateTime?
  deletedBy               String?
  status                  UserStatus                @default(ACTIVE)
  activityLogs            ActivityLog[]
  admins                  Admin[]
  announcementReads       AnnouncementRead[]
  announcementAuthor      Announcement[]            @relation("AnnouncementAuthor")
  auditLogs               AuditLog[]
  candidates              Candidate[]
  emailVerifications      EmailVerification[]
  eventRegistrations      EventRegistration[]
  approvedEvents          Event[]                   @relation("EventApprover")
  createdEvents           Event[]                   @relation("EventCreator")
  executiveMembers        ExecutiveMember[]
  featureFlagTargets      FeatureFlagTarget[]
  files                   File[]
  notificationPreferences NotificationPreference[]
  notifications           Notification[]
  operationalAuditLogs    OperationalAuditLog[]
  reviewedJoinRequests    OrganizationJoinRequest[] @relation("JoinRequestReviewer")
  joinRequests            OrganizationJoinRequest[] @relation("JoinRequestUser")
  organizationMemberships OrganizationMembership[]
  createdOrganizations    Organization[]            @relation("OrganizationCreator")
  passwordResets          PasswordReset[]
  payments                Payment[]
  pendingPayments         PendingPayment[]
  pushQueues              PushQueue[]
  receipts                Receipt[]
  savingsGoals            SavingsGoal[]
  sessions                Session[]
  studentProfile          StudentProfile?
  ticketPurchases         TicketPurchase[]
  profile                 UserProfile?
  votes                   Vote[]
  wallet                  Wallet?
  withdrawals             Withdrawal[]
  bankAccounts            BankAccount[]

  @@index([email])
  @@index([username])
  @@index([status])
  @@map("users")
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  expiresAt        DateTime
  ipAddress        String?
  userAgent        String?
  createdAt        DateTime  @default(now())
  browser          String?
  deviceName       String?
  isActive         Boolean   @default(true)
  lastUsedAt       DateTime  @default(now())
  operatingSystem  String?
  refreshTokenHash String    @unique
  revokedAt        DateTime?
  revokedReason    String?
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshTokenHash])
  @@index([isActive])
  @@map("sessions")
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("password_resets")
}

model EmailVerification {
  id         String    @id @default(cuid())
  userId     String
  email      String
  token      String    @unique
  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("email_verifications")
}

model UserProfile {
  id                    String             @id @default(cuid())
  userId                String             @unique
  firstName             String
  lastName              String
  middleName            String?
  phone                 String?
  avatar                String?
  gender                Gender?
  dateOfBirth           DateTime?
  country               String?
  state                 String?
  city                  String?
  address               String?
  bio                   String?
  onboardingStep        OnboardingStep     @default(PERSONAL_INFO)
  onboardingCompleted   Boolean            @default(false)
  onboardingCompletedAt DateTime?
  verificationStatus    VerificationStatus @default(UNVERIFIED)
  verifiedAt            DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model Institution {
  id            String            @id @default(cuid())
  name          String
  shortName     String
  code          String            @unique
  logo          String?
  website       String?
  email         String?
  phone         String?
  address       String?
  city          String?
  state         String?
  country       String?
  status        InstitutionStatus @default(ACTIVE)
  createdBy     String?
  updatedBy     String?
  deletedAt     DateTime?
  deletedBy     String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  sessions      AcademicSession[]
  admins        Admin[]
  dues          Due[]
  faculties     Faculty[]
  organizations Organization[]
  students      StudentProfile[]

  @@index([code])
  @@map("institutions")
}

model Faculty {
  id               String            @id @default(cuid())
  institutionId    String
  name             String
  code             String
  logo             String?
  status           FacultyStatus     @default(ACTIVE)
  createdBy        String?
  updatedBy        String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  academicSessions AcademicSession[]
  admins           Admin[]
  departments      Department[]
  institution      Institution       @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  organizations    Organization[]
  students         StudentProfile[]

  @@unique([institutionId, code])
  @@index([institutionId])
  @@map("faculties")
}

model Department {
  id               String                  @id @default(cuid())
  facultyId        String
  name             String
  code             String
  logo             String?
  promotionType    PromotionType
  status           DepartmentStatus        @default(ACTIVE)
  createdBy        String?
  updatedBy        String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  academicLevels   AcademicLevel[]
  academicSessions AcademicSession[]
  admins           Admin[]
  faculty          Faculty                 @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  organizations    Organization[]
  students         StudentAcademicRecord[]
  studentProfiles  StudentProfile[]

  @@unique([facultyId, code])
  @@index([facultyId])
  @@map("departments")
}

model AcademicLevel {
  id               String                  @id @default(cuid())
  departmentId     String
  name             String
  numericLevel     Int
  order            Int
  status           AcademicLevelStatus     @default(ACTIVE)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  academicSessions AcademicSession[]
  department       Department              @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  organizations    Organization[]
  academicRecords  StudentAcademicRecord[]
  students         StudentProfile[]
  promotionsFrom   StudentPromotion[]      @relation("FromLevel")
  promotionsTo     StudentPromotion[]      @relation("ToLevel")

  @@unique([departmentId, name])
  @@index([departmentId])
  @@map("academic_levels")
}

model AcademicSession {
  id              String                   @id @default(cuid())
  institutionId   String
  facultyId       String?
  departmentId    String?
  academicLevelId String?
  name            String
  startDate       DateTime
  endDate         DateTime
  status          AcademicSessionStatus
  scope           SessionScope             @default(INSTITUTION)
  isCurrent       Boolean                  @default(false)
  createdBy       String?
  updatedBy       String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  academicLevel   AcademicLevel?           @relation(fields: [academicLevelId], references: [id])
  department      Department?              @relation(fields: [departmentId], references: [id])
  faculty         Faculty?                 @relation(fields: [facultyId], references: [id])
  institution     Institution              @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  admins          Admin[]
  dues            Due[]
  memberships     OrganizationMembership[]
  organizations   Organization[]
  studentRecords  StudentAcademicRecord[]
  promotions      StudentPromotion[]

  @@unique([institutionId, name])
  @@index([institutionId])
  @@index([facultyId])
  @@index([departmentId])
  @@index([academicLevelId])
  @@index([isCurrent])
  @@index([scope])
  @@map("academic_sessions")
}

model StudentProfile {
  id                     String                  @id @default(cuid())
  userId                 String                  @unique
  institutionId          String
  facultyId              String
  departmentId           String
  currentAcademicLevelId String?
  matricNumber           String?
  academicStatus         AcademicStatus          @default(ACTIVE)
  onboardingStep         OnboardingStep          @default(INSTITUTION)
  onboardingCompleted    Boolean                 @default(false)
  onboardingCompletedAt  DateTime?
  verificationStatus     VerificationStatus      @default(UNVERIFIED)
  verifiedAt             DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  dueAssignments         DueAssignment[]
  files                  File[]
  academicRecords        StudentAcademicRecord[]
  enrollments            StudentEnrollment[]
  currentAcademicLevel   AcademicLevel?          @relation(fields: [currentAcademicLevelId], references: [id])
  department             Department              @relation(fields: [departmentId], references: [id])
  faculty                Faculty                 @relation(fields: [facultyId], references: [id])
  institution            Institution             @relation(fields: [institutionId], references: [id])
  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  promotions             StudentPromotion[]
  verifications          StudentVerification[]

  @@index([userId])
  @@index([institutionId])
  @@index([facultyId])
  @@index([departmentId])
  @@index([matricNumber])
  @@map("student_profiles")
}

model StudentAcademicRecord {
  id               String          @id @default(cuid())
  studentId        String
  sessionId        String
  departmentId     String
  academicLevelId  String
  gpa              Float?
  cgpa             Float?
  creditsAttempted Int?
  creditsEarned    Int?
  status           AcademicStatus  @default(ACTIVE)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  academicLevel    AcademicLevel   @relation(fields: [academicLevelId], references: [id])
  department       Department      @relation(fields: [departmentId], references: [id])
  session          AcademicSession @relation(fields: [sessionId], references: [id])
  student          StudentProfile  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, sessionId])
  @@index([studentId])
  @@index([sessionId])
  @@map("student_academic_records")
}

model StudentPromotion {
  id            String          @id @default(cuid())
  studentId     String
  fromLevelId   String
  toLevelId     String
  sessionId     String
  promotedBy    String?
  promotionDate DateTime        @default(now())
  notes         String?
  fromLevel     AcademicLevel   @relation("FromLevel", fields: [fromLevelId], references: [id])
  session       AcademicSession @relation(fields: [sessionId], references: [id])
  student       StudentProfile  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  toLevel       AcademicLevel   @relation("ToLevel", fields: [toLevelId], references: [id])

  @@map("student_promotions")
}

model StudentEnrollment {
  id             String           @id @default(cuid())
  studentId      String
  organizationId String
  roleId         String?
  status         EnrollmentStatus @default(ACTIVE)
  enrolledAt     DateTime         @default(now())
  completedAt    DateTime?
  organization   Organization     @relation(fields: [organizationId], references: [id])
  role           Role?            @relation(fields: [roleId], references: [id])
  student        StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, organizationId])
  @@index([studentId])
  @@index([organizationId])
  @@map("student_enrollments")
}

model StudentVerification {
  id          String             @id @default(cuid())
  studentId   String
  verifiedBy  String?
  status      VerificationStatus @default(PENDING)
  documentUrl String?
  notes       String?
  requestedAt DateTime           @default(now())
  verifiedAt  DateTime?
  expiresAt   DateTime?
  student     StudentProfile     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([status])
  @@map("student_verifications")
}

model Organization {
  id                   String                    @id @default(cuid())
  institutionId        String
  facultyId            String?
  departmentId         String?
  academicLevelId      String?
  parentOrganizationId String?
  name                 String
  slug                 String
  description          String?
  logo                 String?
  type                 OrganizationType
  scope                OrganizationScope
  status               OrganizationStatus        @default(DRAFT)
  createdBy            String?
  updatedBy            String?
  activatedAt          DateTime?
  archivedAt           DateTime?
  deletedAt            DateTime?
  deletedBy            String?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  academicSessionId    String?
  admins               Admin[]
  announcements        Announcement[]
  committees           Committee[]
  dues                 Due[]
  elections            Election[]
  events               Event[]
  executiveTerms       ExecutiveTerm[]
  featureFlagTargets   FeatureFlagTarget[]
  files                File[]
  ledgerAccounts       LedgerAccount[]
  joinRequests         OrganizationJoinRequest[]
  memberships          OrganizationMembership[]
  academicLevel        AcademicLevel?            @relation(fields: [academicLevelId], references: [id])
  academicSession      AcademicSession?          @relation(fields: [academicSessionId], references: [id])
  creator              User?                     @relation("OrganizationCreator", fields: [createdBy], references: [id])
  department           Department?               @relation(fields: [departmentId], references: [id])
  faculty              Faculty?                  @relation(fields: [facultyId], references: [id])
  institution          Institution               @relation(fields: [institutionId], references: [id])
  parent               Organization?             @relation("OrganizationHierarchy", fields: [parentOrganizationId], references: [id])
  children             Organization[]            @relation("OrganizationHierarchy")
  payments             Payment[]
  pendingPayments      PendingPayment[]
  receipts             Receipt[]
  roles                Role[]
  settlements          Settlement[]
  studentEnrollments   StudentEnrollment[]
  wallet               Wallet?

  @@unique([institutionId, slug, academicSessionId])
  @@index([institutionId])
  @@index([facultyId])
  @@index([departmentId])
  @@index([academicLevelId])
  @@index([academicSessionId])
  @@index([type])
  @@index([status])
  @@map("organizations")
}

model OrganizationMembership {
  id              String           @id @default(cuid())
  organizationId  String
  userId          String
  membershipType  MembershipType
  status          MembershipStatus
  isPrimary       Boolean          @default(false)
  joinedAt        DateTime
  joinedSessionId String?
  leftAt          DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  roles           MembershipRole[]
  session         AcademicSession? @relation(fields: [joinedSessionId], references: [id])
  organization    Organization     @relation(fields: [organizationId], references: [id])
  user            User             @relation(fields: [userId], references: [id])

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId])
  @@index([status])
  @@map("organization_memberships")
}

model OrganizationJoinRequest {
  id             String            @id @default(cuid())
  organizationId String
  userId         String
  status         JoinRequestStatus @default(PENDING)
  membershipType MembershipType    @default(STUDENT)
  message        String?
  reviewedBy     String?
  reviewedAt     DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reviewer       User?             @relation("JoinRequestReviewer", fields: [reviewedBy], references: [id])
  user           User              @relation("JoinRequestUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId, status])
  @@map("organization_join_requests")
}

model Role {
  id                 String              @id @default(cuid())
  organizationId     String
  name               String
  description        String?
  isSystem           Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  executiveMembers   ExecutiveMember[]
  featureFlagTargets FeatureFlagTarget[]
  members            MembershipRole[]
  permissions        RolePermission[]
  organization       Organization        @relation(fields: [organizationId], references: [id])
  studentEnrollments StudentEnrollment[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("roles")
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  name        String
  description String?
  category    String?
  createdAt   DateTime         @default(now())
  roles       RolePermission[]

  @@index([key])
  @@index([category])
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id])
  role         Role       @relation(fields: [roleId], references: [id])

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model MembershipRole {
  id           String                 @id @default(cuid())
  membershipId String
  roleId       String
  assignedBy   String?
  assignedAt   DateTime               @default(now())
  membership   OrganizationMembership @relation(fields: [membershipId], references: [id])
  role         Role                   @relation(fields: [roleId], references: [id])

  @@unique([membershipId, roleId])
  @@map("membership_roles")
}

model Admin {
  id                String            @id @default(cuid())
  userId            String
  adminType         AdminType
  institutionId     String?
  facultyId         String?
  departmentId      String?
  organizationId    String?
  assignedBy        String?
  assignedAt        DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  status            AdminStatus       @default(ACTIVE)
  revokedAt         DateTime?
  revokedReason     String?
  academicSessionId String?
  permissions       AdminPermission[]
  academicSession   AcademicSession?  @relation(fields: [academicSessionId], references: [id])
  department        Department?       @relation(fields: [departmentId], references: [id])
  faculty           Faculty?          @relation(fields: [facultyId], references: [id])
  institution       Institution?      @relation(fields: [institutionId], references: [id])
  organization      Organization?     @relation(fields: [organizationId], references: [id])
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, adminType, institutionId, facultyId, departmentId, organizationId, academicSessionId])
  @@index([userId])
  @@index([adminType])
  @@index([status])
  @@map("admins")
}

model AdminPermission {
  id                 String             @id @default(cuid())
  adminId            String
  permissionKey      String
  permissionCategory PermissionCategory
  permissionAction   PermissionAction
  resourceId         String?
  grantedBy          String?
  grantedAt          DateTime           @default(now())
  admin              Admin              @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@unique([adminId, permissionKey, resourceId])
  @@index([adminId])
  @@index([permissionKey])
  @@map("admin_permissions")
}

model SystemRole {
  id          String             @id @default(cuid())
  name        String             @unique
  description String?
  category    SystemRoleCategory
  isDefault   Boolean            @default(false)
  permissions String[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@map("system_roles")
}

model Wallet {
  id               String       @id @default(cuid())
  userId           String?      @unique
  organizationId   String?      @unique
  isPlatformWallet Boolean      @default(false)
  balance          Int          @default(0)
  heldBalance      Int          @default(0)
  currency         String       @default("NGN")
  status           WalletStatus @default(ACTIVE)
  ledgerAccountId  String?      @unique
  metadata         Json? // ADD THIS FIELD
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  ledgerAccount LedgerAccount? @relation(fields: [ledgerAccountId], references: [id])
  user          User?          @relation(fields: [userId], references: [id])
  organization  Organization?  @relation(fields: [organizationId], references: [id])
  transactions  Transaction[]
  holds         WalletHold[]
  withdrawals   Withdrawal[]

  @@index([isPlatformWallet])
  @@map("wallets")
}

model WalletHold {
  id         String     @id @default(cuid())
  walletId   String
  amount     Int
  reason     String?
  expiresAt  DateTime?
  status     HoldStatus @default(ACTIVE)
  createdAt  DateTime   @default(now())
  releasedAt DateTime?
  wallet     Wallet     @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([status])
  @@map("wallet_holds")
}

model LedgerAccount {
  id             String                 @id @default(cuid())
  organizationId String?
  name           String
  code           String                 @unique
  type           LedgerAccountType
  balance        Int                    @default(0)
  currency       String                 @default("NGN")
  isActive       Boolean                @default(true)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  category       LedgerAccountCategory?
  description    String?
  isSystem       Boolean                @default(false)
  ownerId        String?
  ownerType      LedgerAccountOwnerType @default(SYSTEM)
  parentId       String?
  pendingBalance Int                    @default(0)
  walletId       String?                @unique
  createdBy      String?
  metadata       Json?
  journalLines   JournalLine[]
  organization   Organization?          @relation(fields: [organizationId], references: [id])
  parent         LedgerAccount?         @relation("LedgerAccountHierarchy", fields: [parentId], references: [id])
  children       LedgerAccount[]        @relation("LedgerAccountHierarchy")
  ledgerEntries  LedgerEntry[]
  wallet         Wallet?

  @@unique([ownerType, ownerId, code])
  @@index([organizationId])
  @@index([code])
  @@index([type])
  @@index([ownerType])
  @@index([ownerId])
  @@map("ledger_accounts")
}

model LedgerEntry {
  id            String          @id @default(cuid())
  accountId     String
  transactionId String
  amount        Int
  type          LedgerEntryType
  balanceBefore Int
  balanceAfter  Int
  description   String?
  createdAt     DateTime        @default(now())
  account       LedgerAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  transaction   Transaction     @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([transactionId])
  @@map("ledger_entries")
}

model JournalEntry {
  id            String             @id @default(cuid())
  reference     String             @unique
  description   String?
  transactionId String?            @unique
  paymentId     String?            @unique
  withdrawalId  String?            @unique
  refundId      String?            @unique
  entryDate     DateTime           @default(now())
  status        JournalEntryStatus @default(POSTED)
  isBalanced    Boolean            @default(false)
  verifiedBy    String?
  verifiedAt    DateTime?
  createdBy     String?
  notes         String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  lines         JournalLine[]
  payment       Payment?
  refund        Refund?
  transaction   Transaction?
  withdrawal    Withdrawal?

  @@index([reference])
  @@index([transactionId])
  @@index([paymentId])
  @@index([entryDate])
  @@index([status])
  @@map("journal_entries")
}

model JournalLine {
  id              String          @id @default(cuid())
  journalEntryId  String
  ledgerAccountId String
  type            JournalLineType
  amount          Int
  description     String?
  createdAt       DateTime        @default(now())
  journalEntry    JournalEntry    @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  ledgerAccount   LedgerAccount   @relation(fields: [ledgerAccountId], references: [id])

  @@index([journalEntryId])
  @@index([ledgerAccountId])
  @@map("journal_lines")
}

model Transaction {
  id             String            @id @default(cuid())
  walletId       String
  type           TransactionType
  amount         Int
  fee            Int               @default(0)
  netAmount      Int
  status         TransactionStatus @default(PENDING)
  reference      String            @unique
  description    String?
  metadata       Json?
  completedAt    DateTime?
  failedAt       DateTime?
  failureReason  String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  journalEntryId String?           @unique
  entries        LedgerEntry[]
  payment        Payment?
  refund         Refund?
  settlement     Settlement?
  journalEntry   JournalEntry?     @relation(fields: [journalEntryId], references: [id])
  wallet         Wallet            @relation(fields: [walletId], references: [id], onDelete: Cascade)
  withdrawal     Withdrawal?

  @@index([walletId])
  @@index([reference])
  @@index([status])
  @@index([journalEntryId])
  @@map("transactions")
}

model Payment {
  id              String            @id @default(cuid())
  payerId         String
  organizationId  String
  transactionId   String?           @unique
  amount          Int
  serviceFee      Int               @default(0)
  status          PaymentStatus     @default(PENDING)
  paymentMethod   PaymentMethodType
  reference       String            @unique
  description     String?
  metadata        Json?
  paidAt          DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
